generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. User & Profile Models
model User {
  id          String        @id @default(uuid())
  phoneNumber String?       @unique
  email       String?       @unique
  password    String?       // Optional if only using OTP
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  profiles    Profile?
  testAttempts TestAttempt[]
  errorReports ErrorReport[]
}

model Profile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  targetExam    String    @default("JEE Mains")
  age           Int?
  school        String?
  avatarUrl     String?
  currentStreak Int       @default(1)
  longestStreak Int       @default(1)
  lastActiveDate DateTime?
  streakHistory Json?
}

// 2. Exam Structure Models
model Exam {
  id          String   @id @default(uuid())
  name        String   // e.g., "JEE Main"
  shifts      Shift[]
}

model Shift {
  id        String     @id @default(uuid())
  examId    String
  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  name      String     // e.g., "2026 Jan Shift 1"
  date      DateTime
  questions Question[]
  attempts  TestAttempt[]
}

model Question {
  id            String   @id @default(uuid())
  shiftId       String
  shift         Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  subject       String   // "Physics", "Chemistry", "Math"
  questionText  String   @db.Text
  imageUrl      String?  // If question contains a complex diagram
  optionA       String   @db.Text
  optionB       String   @db.Text
  optionC       String   @db.Text
  optionD       String   @db.Text
  correctOption String   // "A", "B", "C", or "D"
  positiveMarks Float    @default(4)
  negativeMarks Float    @default(-1)
  orderIndex    Int      @default(0)
  errorReports  ErrorReport[]
}

// 3. Post-Exam Storage Models
model TestAttempt {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId      String
  shift        Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  score        Float
  submittedAt  DateTime @default(now())
  answersSaved Json     // Stores final chosen answers and per-question time array as JSON block
}

// 4. Error Reports Storage Model
model ErrorReport {
  id           String    @id @default(uuid())
  status       String    @default("pending") // pending, reviewing, resolved, rejected
  questionId   String    @map("question_id")
  userId       String    @map("user_id")
  errorType    String    @map("error_type")
  description  String    @db.Text
  adminComment String?   @map("admin_comment") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")

  question     Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("error_reports")
}

// 5. Organisation & Institutional Testing Models
model Organization {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique // Unique short code / slug e.g. "DPS-DELHI"
  contactEmail String?
  contactPhone String?
  address      String?
  logoUrl      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tests        OrgTest[]
  testRequests OrgTestRequest[]
}

model OrgTest {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title           String           // e.g. "Term 1 Physics Olympiad 2026"
  accessCode      String           @unique // e.g. "DPS-PHY-8821" or "EXAM-4821"
  description     String?          @db.Text
  subject         String           @default("General")
  durationMinutes Int              @default(60)
  positiveMarks   Float            @default(4)
  negativeMarks   Float            @default(-1)
  startTime       DateTime?        // Optional window start
  endTime         DateTime?        // Optional window end
  status          String           @default("ACTIVE") // ACTIVE, DRAFT, CLOSED
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  questions       OrgQuestion[]
  attempts        OrgTestAttempt[]
  testRequests    OrgTestRequest[]
}

model OrgTestRequest {
  id               String        @id @default(uuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title            String
  description      String?       @db.Text
  subject          String        @default("General")
  durationMinutes  Int           @default(60)
  positiveMarks    Float         @default(4)
  negativeMarks    Float         @default(-1)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  expectedStudents Int           @default(50)
  pdfUrl           String?       @db.Text
  pdfFileName      String?
  status           String        @default("PENDING_JSON_CONVERSION") // PENDING_JSON_CONVERSION, CONVERTED, REJECTED
  orgTestId        String?
  orgTest          OrgTest?      @relation(fields: [orgTestId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model OrgQuestion {
  id            String    @id @default(uuid())
  orgTestId     String
  orgTest       OrgTest   @relation(fields: [orgTestId], references: [id], onDelete: Cascade)
  subject       String    @default("General")
  questionText  String    @db.Text
  imageUrl      String?
  optionA       String    @db.Text
  optionB       String    @db.Text
  optionC       String    @db.Text
  optionD       String    @db.Text
  correctOption String    // "A", "B", "C", "D"
  explanation   String?   @db.Text
  positiveMarks Float     @default(4)
  negativeMarks Float     @default(-1)
  orderIndex    Int       @default(0)
  createdAt     DateTime  @default(now())
}

model OrgTestAttempt {
  id                String    @id @default(uuid())
  orgTestId         String
  orgTest           OrgTest   @relation(fields: [orgTestId], references: [id], onDelete: Cascade)
  studentName       String
  studentEmail      String?
  studentRollNumber String?
  userId            String?
  score             Float
  maxScore          Float
  percentage        Float
  correctCount      Int
  incorrectCount    Int
  unattemptedCount  Int
  answersSaved      Json      // Map of questionId -> { selected, isCorrect, timeSpentSeconds }
  violationsCount   Int       @default(0)
  terminatedBySecurity Boolean @default(false)
  submittedAt       DateTime  @default(now())
}

// 6. Admin Email Whitelist Model
model AdminEmail {
  id        String    @id @default(uuid())
  email     String    @unique
  role      String    @default("ADMIN") // SUPERADMIN, ADMIN, TEACHER
  addedBy   String?
  createdAt DateTime  @default(now())
}